{
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make check-env)",
      "Bash(make prepare)",
      "Bash(make analyze)",
      "Bash(make test)",
      "Bash(make docker-build)",
      "Bash(make docker-analyze)",
      "Bash(make docker-shell)",
      "Bash(make docker-view)",
      "Bash(make docker-clean)",
      "Bash(docker compose build *)",
      "Bash(docker compose down *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)"
    ],
    "ask": [
      "Bash(make eval)",
      "Bash(make docker-eval)",
      "Bash(make run-all)",
      "Bash(make docker-run)",
      "Bash(docker compose run *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in */promptfooconfig.yaml) rel=\"${f#$PWD/}\"; docker compose run --rm eval npx promptfoo validate -c \"$rel\" ;; esac; }",
            "timeout": 60,
            "statusMessage": "Validating promptfoo config..."
          }
        ]
      }
    ]
  }
}
